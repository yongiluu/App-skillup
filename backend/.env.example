# Copia este archivo como .env (el .env NO se sube al repo).
APP_ENV=local
# Orígenes del frontend permitidos (separados por coma). Vite usa el 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# "Hoy" de los datos de ejemplo (los mocks cubren 2025-09-29 a 2025-11-02).
MOCK_HOY=2025-10-17
# Umbrales de riesgo acordados.
UMBRAL_ALERTA=0.55
UMBRAL_ALTO=0.75

# Etapa 2 (aún no se usan) — las entrega el responsable de base de datos:
# SUPABASE_URL=
# SUPABASE_KEY=
# DATABASE_URL=
