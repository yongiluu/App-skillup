# Copia este archivo como .env (el .env NO se sube al repo; ya está en .gitignore).
APP_ENV=local

# --- Seguridad ---
# Clave para firmar los tokens (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la dejas vacía en local, se genera una temporal al arrancar.
# En producción (APP_ENV=production) es obligatoria.
SECRET_KEY=
# Contraseña de los usuarios de prueba "jefe" y "empleado". Elige una y compártela
# con el equipo por un canal privado (no por el repo). Vacía = login deshabilitado.
DEMO_PASSWORD=
# Duración de la sesión en minutos.
TOKEN_MINUTOS=480
# Bloqueo tras intentos fallidos de login.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=5

# Orígenes del frontend permitidos (separados por coma). Vite usa el 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Fuente de datos ---
# mock     = archivos de app/mocks (no necesita base de datos; es lo que usa la CI)
# supabase = base de datos real (necesita DATABASE_URL)
FUENTE_DATOS=mock
# Cadena de conexión de Supabase: botón Connect → "Session pooler" → URI (funciona en cualquier red).
# La conexión directa db.<proyecto>.supabase.co solo funciona con IPv6.
# NUNCA la subas al repo ni la pegues en un PR o issue.
DATABASE_URL=
# Sucursal que atiende esta API (id de la tabla local). Vacío = la primera.
# LOCAL_ID=

# --- Datos de ejemplo ---
# "Hoy" de los mocks (cubren 2025-09-29 a 2025-11-02).
MOCK_HOY=2025-10-17
# Umbrales de riesgo acordados.
UMBRAL_ALERTA=0.55
UMBRAL_ALTO=0.75
