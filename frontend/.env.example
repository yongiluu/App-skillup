# Copia este archivo como .env.local (los *.local NO se suben al repo).
# Ojo: todo lo que empiece con VITE_ queda visible en el navegador. Nunca pongas claves aquí.

# URL de la API de backend (FastAPI de Diego).
VITE_API_URL=http://localhost:8000

# true = datos simulados (no necesita backend). false = llama a la API real.
VITE_USAR_MOCKS=true
